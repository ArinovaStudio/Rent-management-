generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PROPERTY_ADMIN
  PROPERTY_MANAGER
}

enum PropertyType {
  PG
  APARTMENT
  FLAT
  BUILDING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum AllocationStatus {
  ACTIVE
  CHECKED_OUT
}

enum AccountType {
  INDIVIDUAL
  COMPANY
}

// Owner onboarding / KYC lifecycle. New owners start at CONTACT_PENDING.
enum VerificationStatus {
  CONTACT_PENDING
  KYC_PENDING
  NEEDS_MORE_INFO
  VERIFIED
  RESTRICTED
  REJECTED
}

enum IdType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENSE
}

enum PropertyRelationship {
  OWNER
  CO_OWNER
  LEASEHOLDER
  POWER_OF_ATTORNEY
  AUTHORIZED_MANAGER
}

enum RoomMediaType {
  IMAGE
  VIDEO
}

enum SensitiveDocumentType {
  ID_DOCUMENT
  ADDRESS_PROOF
  COMPANY_REGISTRATION
  AUTHORITY_PROOF
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueCategory {
  MAINTENANCE
  PLUMBING
  ELECTRICAL
  CLEANING
  SECURITY
  RESIDENT_COMPLAINT
  BILLING
  SAFETY
  OTHER
}


model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String?
  googleId      String?        @unique
  // Set when the email is proven to belong to the user (Google sign-in today, email OTP in Phase 2).
  emailVerifiedAt DateTime?
  role          Role           @default(PROPERTY_ADMIN)
  createdAt     DateTime       @default(now())
  createdById   String?
  createdBy     User?          @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers  User[]         @relation("CreatedUsers")
  refreshTokens RefreshToken[]
  emailOtps     EmailOtp[]
  properties    Property[]     @relation("OwnedProperties")
  coOwnedProperties PropertyCoOwner[] @relation("PropertyCoOwnerUser")
  assignedPropertyCoOwners PropertyCoOwner[] @relation("PropertyCoOwnerAssigner")
  managedProperties PropertyManager[] @relation("ManagedProperties")
  reportedIssues    Issue[]           @relation("ReportedIssues")
  issueReplies      IssueReply[]
  receivedIssues    Issue[]           @relation("IssueRecipient")
  // Null for accounts created before owner onboarding existed, for Super Admins and for managers.
  ownerProfile  OwnerProfile?
}

// Everything we know about an owner from onboarding. Sensitive data lives here and in
// SensitiveDocument, never on User. Full ID numbers are NOT stored, only a masked form.
model OwnerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: basic details
  accountType     AccountType @default(INDIVIDUAL)
  legalName       String // person's legal name, or the registered company name
  phone           String? // E.164, e.g. +919876543210. Null until step 1 is saved (Google sign-ups).
  phoneVerifiedAt DateTime?

  // Step 2: identity
  idType         IdType?
  idNumberMasked String? // e.g. XXXXXXXX1234
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  // Company only
  companyRegistrationNumber String?
  gstin                     String?
  signatoryName             String?
  signatoryDesignation      String?

  // Step 3: property relationship and consents (timestamps are set by the server)
  propertyRelationship        PropertyRelationship?
  authorityDetails            String?
  termsAcceptedAt             DateTime?
  termsVersion                String?
  privacyAcceptedAt           DateTime?
  privacyVersion              String?
  kycConsentAt                DateTime?
  kycConsentVersion           String?
  authorityDeclaredAt         DateTime?
  authorityDeclarationVersion String?

  // Onboarding progress: number of wizard steps saved (0-3). Used to resume.
  completedSteps        Int       @default(0)
  onboardingCompletedAt DateTime?

  verificationStatus VerificationStatus @default(CONTACT_PENDING)
  statusUpdatedAt    DateTime           @default(now())
  // Latest KYC review decision (full history is in AuditEvent)
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?

  documents SensitiveDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

// KYC files. The bytes live outside the public uploads folder (see lib/uploads.ts, SENSITIVE_ROOT).
model SensitiveDocument {
  id             String                @id @default(cuid())
  ownerProfileId String
  ownerProfile   OwnerProfile          @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  type           SensitiveDocumentType
  path           String // relative to SENSITIVE_ROOT
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  uploadedAt     DateTime              @default(now())

  @@index([ownerProfileId, type])
}

// One row per issued refresh token. Tokens from the same login share a familyId.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  familyId  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

model Property {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        PropertyType
  address     String
  city        String
  latitude    Float?
  longitude   Float?
  bedrooms    Int?
  bathrooms   Int?
  areaSqft    Int?
  floors      Int?
  roomsPerFloor Int?
  totalRooms Int?
  sharing     Boolean            @default(false)
  status      ReviewStatus       @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedById String?
  ownerId     String
  owner       User               @relation("OwnedProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  rooms       Room[]
  images      PropertyImage[]
  categoryMedia RoomCategoryMedia[]
  documents   PropertyDocument[]
  // Proof of ownership/authority. Kept apart from the owner's personal KYC documents.
  authorityProof PropertyAuthorityProof?
  coOwners PropertyCoOwner[]
  // --- Listing details ---
  category            String?
  district            String?
  state               String?
  yearBuilt           Int?
  developer           String?
  price               Int?
  serviceCharge       Int?
  builtUpAreaSqm      Float?
  plotSizeSqm         Float?
  pricePerSqm         Int?
  shortDescription    String?
  videoUrl            String?
  videoPath           String?
  parkingSpaces       Int?
  furnishing          String?
  facing              String?
  titleDeedNumber     String?
  handoverDate        DateTime?
  roomLayout          Json      @default("[]")
  bathroomLayout      Json      @default("[]")
  // PG only: offered room categories + rent, and per-floor setup (rooms, bathrooms, rent adjustment)
  pgConfig            Json      @default("{}")
  amenities           String[]  @default([])
  features            String[]  @default([])
  nearbyPlaces        Json      @default("[]")
  isPublished         Boolean   @default(true)
  featured            Boolean   @default(false)
  // Google Maps link as pasted by the owner, monthly charge per amenity (name -> rupees; missing = included),
  // and whether the property is open for new residents (false = e.g. under construction)
  mapUrl              String?
  amenityCharges      Json      @default("{}")
  isActive            Boolean   @default(true)
  inactiveNote        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  managers PropertyManager[]
  issues   Issue[]

  @@index([ownerId])
  @@index([status])
}

// The unit people get allocated to: a PG room, a bedroom in a sharing flat,
// or the single "Entire property" row for a non-sharing flat/apartment.
model Room {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  capacity   Int
  occupied   Int      @default(0)
  ac         Boolean  @default(false)
  rent       Int
  floor      Int?
  roomType         String?
  sizeSqm          Float?
  bathroomAttached Boolean  @default(true)
  bathroomAreaSqm  Float?
  bedrooms         Int? // Building flats: BHK
  bathrooms        Int? // Building flats: bathroom count
  furnishing       String? // Building flats: UNFURNISHED | SEMI_FURNISHED | FURNISHED
  features         Json     @default("[]") // Building flats: features & finishes of this flat
  images           Json     @default("[]")
  isActive         Boolean  @default(true) // false = not open for new residents (e.g. under construction)
  inactiveNote     String?
  createdAt  DateTime @default(now())
  allocations Allocation[]
  issues Issue[]

  @@index([propertyId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  path       String
  createdAt  DateTime @default(now())
  sortOrder  Int      @default(0)

  @@index([propertyId])
}


model RoomCategoryMedia {
  id         String        @id @default(cuid())
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  capacity   Int
  mediaType  RoomMediaType
  path       String
  originalName String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([propertyId, capacity, mediaType])
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  path       String
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model Allocation {
  id              String           @id @default(cuid())
  roomId          String
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)

  fullName        String
  email           String?
  phone           String
  moveInDate      DateTime
  monthlyRent     Int
  securityDeposit Int              @default(0)
  issues          Issue[]
  occupants       Int              @default(1) // people living under this allocation (a whole flat can have several)
  isHousemate     Boolean          @default(false) // Building: shares a flat with its main tenant; no link of their own, rent and bills sit on the main tenant

  status          AllocationStatus @default(ACTIVE)
  accessToken     String           @unique

  roomCategory    String?
  floorNumber     Int?
  // Snapshots taken when the person moves in, so later edits to the flat never change a past tenant's record
  roomLabel       String?
  roomBhk         Int?
  moveOutDate     DateTime?

  documents       ResidentDocument[]
  bills           ResidentBill[]
  rentPayments    RentPayment[]
  // Tax % per invoice line for this tenant: { "RENT": 5, "AMENITY:Gym": 18 }. Missing = 0%.
  taxRates        Json             @default("{}")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([roomId, status])
  @@index([phone])
}

model ResidentDocument {
  id           String     @id @default(cuid())
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  name         String
  path         String
  createdAt    DateTime   @default(now())

  @@index([allocationId])
}

// Email OTP. Only a hash of the code is stored. Used for the owner's email verification.
model EmailOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  // VERIFY = confirm the email address, PASSWORD = authorise a password change
  purpose    String    @default("VERIFY")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// Who opened which KYC document. Never holds ID numbers.
model DocumentAccessLog {
  id         String   @id @default(cuid())
  documentId String
  actorId    String
  actorRole  Role
  action     String // VIEW
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([actorId])
}

// Ownership/authorization proof for a property. Bytes live under SENSITIVE_ROOT/properties/<id>.
model PropertyAuthorityProof {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  path         String
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedAt   DateTime @default(now())
}

// One row per review decision or status change. Covers KYC review history, property approval
// history, status history and Super Admin action logs. Notes may be shown to the owner.
model AuditEvent {
  id          String   @id @default(cuid())
  subjectType String // OWNER_KYC | PROPERTY
  subjectId   String // OwnerProfile.id or Property.id
  actorId     String
  action      String // APPROVE | REJECT | REQUEST_INFO | RESTRICT | RESUBMIT
  fromStatus  String
  toStatus    String
  note        String?
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId])
}



// A co-owner is linked to a property independently of its primary owner.
model PropertyCoOwner {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("PropertyCoOwnerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("PropertyCoOwnerAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  documents    PropertyCoOwnerDocument[]

  @@unique([propertyId, userId])
  @@index([userId])
}

// Co-owner proof is private and independently associated with the assigned co-owner.
model PropertyCoOwnerDocument {
  id                  String          @id @default(cuid())
  propertyCoOwnerId   String
  propertyCoOwner     PropertyCoOwner @relation(fields: [propertyCoOwnerId], references: [id], onDelete: Cascade)
  name                String
  path                String
  originalName        String
  mimeType            String
  sizeBytes           Int
  sha256              String
  uploadedAt          DateTime        @default(now())

  @@index([propertyCoOwnerId, uploadedAt])
}

// One row per (property, manager). A manager can have many rows, a property can have many managers.
model PropertyManager {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  managerId    String
  manager      User     @relation("ManagedProperties", fields: [managerId], references: [id], onDelete: Cascade)
  assignedById String
  createdAt    DateTime @default(now())

  @@unique([propertyId, managerId])
  @@index([managerId])
}

model Issue {
  id             String        @id @default(cuid())
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedById   String
  reportedBy     User          @relation("ReportedIssues", fields: [reportedById], references: [id], onDelete: Cascade)
  title          String
  description    String
  priority       IssuePriority @default(MEDIUM)
  status         IssueStatus   @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  // Ticket details. A manager raises it; it goes to the property's owner (Property Admin) and
  // can be escalated to the Super Admin (escalatedAt set). Tickets on a Super Admin's own property start escalated.
  ticketNo       Int           @unique @default(autoincrement())
  // Long random ticket number shown to people, e.g. SUN-F02-R204-S3-PLM-48291037 (old tickets have none and show #ticketNo)
  ticketCode     String?       @unique
  category       IssueCategory @default(OTHER)
  allocationId   String?
  allocation     Allocation?   @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  neededBy       DateTime?
  images         Json          @default("[]")
  escalatedAt    DateTime?
  // Who the ticket was sent to: null = the property's main owner, otherwise a co-owner chosen by the manager
  recipientId    String?
  recipient      User?         @relation("IssueRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  replies        IssueReply[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([propertyId, status])
  @@index([reportedById])
  @@index([recipientId])
}

// Conversation on a ticket: replies, status changes and the escalation note.
model IssueReply {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      String   @default("REPLY") // REPLY | STATUS | ESCALATED
  message   String
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

enum BillType {
  ELECTRICITY
  WATER
}

// One bill per resident, per type, per month. Saving the same month again updates it.
model ResidentBill {
  id           String     @id @default(cuid())
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  type         BillType
  period       String // "2026-11"
  amount       Int // rupees
  note         String?
  // Tax % on this bill. `amount` stays the amount before tax.
  taxPct       Float      @default(0)
  paid         Boolean    @default(false)
  paidAt       DateTime?
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([allocationId])
  @@index([allocationId, type, period])
}

// Rent paid / unpaid per month for a main tenant. Managers set it from the Payment Ledger.
model RentPayment {
  id           String     @id @default(cuid())
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  period       String // "2026-11"
  amount       Int // rent that month, saved when the status is set
  taxPct       Float      @default(0) // rent tax % saved when the month is marked paid
  paid         Boolean    @default(false)
  paidAt       DateTime?
  updatedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([allocationId, period])
  @@index([allocationId])
}
